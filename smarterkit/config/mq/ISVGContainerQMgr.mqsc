*STOP LISTENER('SYSTEM.DEFAULT.LISTENER.TCP') IGNSTATE(YES)

* Developer queues
DEFINE QLOCAL('itim_ms')                DEFPSIST(YES) MAXDEPTH(999999999) MAXMSGL(104857600) MSGDLVSQ(PRIORITY) REPLACE
DEFINE QLOCAL('itim_rs')                DEFPSIST(YES) MAXDEPTH(999999999) MAXMSGL(104857600) MSGDLVSQ(PRIORITY) REPLACE
DEFINE QLOCAL('itim_wf')                DEFPSIST(YES) MAXDEPTH(999999999) MAXMSGL(104857600) MSGDLVSQ(PRIORITY) REPLACE
DEFINE QLOCAL('ivig_events')            DEFPSIST(YES) MAXDEPTH(999999999) MAXMSGL(104857600) MSGDLVSQ(PRIORITY) REPLACE
DEFINE QLOCAL('itim_adhocSync')         DEFPSIST(YES) MAXDEPTH(999999999) MAXMSGL(104857600) MSGDLVSQ(PRIORITY) REPLACE
DEFINE QLOCAL('itim_rs_pending')        DEFPSIST(YES) MAXDEPTH(999999999) MAXMSGL(104857600) MSGDLVSQ(PRIORITY) REPLACE
DEFINE QLOCAL('itim_ps')                DEFPSIST(YES) MAXDEPTH(999999999) MAXMSGL(104857600) MSGDLVSQ(PRIORITY) REPLACE
DEFINE QLOCAL('itim_import_export')     DEFPSIST(YES) MAXDEPTH(999999999) MAXMSGL(104857600) MSGDLVSQ(PRIORITY) REPLACE
DEFINE QLOCAL('DEV.DEAD.LETTER.QUEUE')  DEFPSIST(YES) MAXDEPTH(999999999) MAXMSGL(104857600) MSGDLVSQ(PRIORITY) REPLACE
DEFINE QLOCAL('itim_certmgr')           DEFPSIST(YES) MAXDEPTH(999999999) MAXMSGL(104857600) MSGDLVSQ(PRIORITY) REPLACE

* Use a different dead letter queue, for undeliverable messages
ALTER QMGR DEADQ('DEV.DEAD.LETTER.QUEUE')

* Developer connection authentication
DEFINE AUTHINFO('DEV.AUTHINFO') AUTHTYPE(IDPWOS) CHCKCLNT(REQDADM) CHCKLOCL(OPTIONAL) ADOPTCTX(YES) REPLACE
ALTER QMGR CONNAUTH('DEV.AUTHINFO')
REFRESH SECURITY(*) TYPE(CONNAUTH)

* Developer channels (Application + Admin)
DEFINE CHANNEL('DEV.ADMIN.SVRCONN') CHLTYPE(SVRCONN) REPLACE
DEFINE CHANNEL('DEV.ISVG.SVRCONN') CHLTYPE(SVRCONN) MCAUSER('app') SSLCIPH(ANY_TLS12_OR_HIGHER) SSLCAUTH(OPTIONAL) REPLACE
ALTER QMGR SSLFIPS({{ ternary "YES" "NO" .Values.fips }})

* Developer channel authentication rules
SET CHLAUTH('*') TYPE(ADDRESSMAP) ADDRESS('*') USERSRC(NOACCESS) DESCR('Back-stop rule - Blocks everyone') ACTION(REPLACE)
SET CHLAUTH('DEV.ISVG.SVRCONN') TYPE(ADDRESSMAP) ADDRESS('*') USERSRC(CHANNEL) CHCKCLNT(ASQMGR) DESCR('Allows connection via APP channel') ACTION(REPLACE)
SET CHLAUTH('DEV.ADMIN.SVRCONN') TYPE(BLOCKUSER) USERLIST('nobody') DESCR('Allows admins on ADMIN channel') ACTION(REPLACE)
SET CHLAUTH('DEV.ADMIN.SVRCONN') TYPE(USERMAP) CLNTUSER('admin') USERSRC(CHANNEL) DESCR('Allows admin user to connect via ADMIN channel') ACTION(REPLACE)
SET CHLAUTH('DEV.ADMIN.SVRCONN') TYPE(USERMAP) CLNTUSER('admin') USERSRC(MAP) MCAUSER ('mqm') DESCR ('Allow admin as MQ-admin') ACTION(REPLACE)

* Developer authority records
SET AUTHREC PRINCIPAL('app') OBJTYPE(QMGR) AUTHADD(CONNECT,INQ)
SET AUTHREC PROFILE('itim_ms') PRINCIPAL('app') OBJTYPE(QUEUE) AUTHADD(BROWSE,GET,INQ,PUT)
SET AUTHREC PROFILE('itim_ms') PRINCIPAL('app') OBJTYPE(TOPIC) AUTHADD(PUB,SUB)
SET AUTHREC PROFILE('itim_rs') PRINCIPAL('app') OBJTYPE(QUEUE) AUTHADD(BROWSE,GET,INQ,PUT)
SET AUTHREC PROFILE('itim_rs') PRINCIPAL('app') OBJTYPE(TOPIC) AUTHADD(PUB,SUB)
SET AUTHREC PROFILE('itim_wf') PRINCIPAL('app') OBJTYPE(QUEUE) AUTHADD(BROWSE,GET,INQ,PUT)
SET AUTHREC PROFILE('itim_wf') PRINCIPAL('app') OBJTYPE(TOPIC) AUTHADD(PUB,SUB)
SET AUTHREC PROFILE('ivig_events') PRINCIPAL('app') OBJTYPE(QUEUE) AUTHADD(BROWSE,GET,INQ,PUT)
SET AUTHREC PROFILE('ivig_events') PRINCIPAL('app') OBJTYPE(TOPIC) AUTHADD(PUB,SUB)
SET AUTHREC PROFILE('itim_adhocSync') PRINCIPAL('app') OBJTYPE(QUEUE) AUTHADD(BROWSE,GET,INQ,PUT)
SET AUTHREC PROFILE('itim_adhocSync') PRINCIPAL('app') OBJTYPE(TOPIC) AUTHADD(PUB,SUB)
SET AUTHREC PROFILE('itim_rs_pending') PRINCIPAL('app') OBJTYPE(QUEUE) AUTHADD(BROWSE,GET,INQ,PUT)
SET AUTHREC PROFILE('itim_rs_pending') PRINCIPAL('app') OBJTYPE(TOPIC) AUTHADD(PUB,SUB)
SET AUTHREC PROFILE('itim_ps') PRINCIPAL('app') OBJTYPE(QUEUE) AUTHADD(BROWSE,GET,INQ,PUT)
SET AUTHREC PROFILE('itim_ps') PRINCIPAL('app') OBJTYPE(TOPIC) AUTHADD(PUB,SUB)
SET AUTHREC PROFILE('itim_import_export') PRINCIPAL('app') OBJTYPE(QUEUE) AUTHADD(BROWSE,GET,INQ,PUT)
SET AUTHREC PROFILE('itim_import_export') PRINCIPAL('app') OBJTYPE(TOPIC) AUTHADD(PUB,SUB)
SET AUTHREC PROFILE('itim_certmgr') PRINCIPAL('app') OBJTYPE(QUEUE) AUTHADD(BROWSE,GET,INQ,PUT)
SET AUTHREC PROFILE('itim_certmgr') PRINCIPAL('app') OBJTYPE(TOPIC) AUTHADD(PUB,SUB)

* Developer listener
*DEFINE LISTENER('DEV.LISTENER.TCP') TRPTYPE(TCP) PORT(1414) CONTROL(QMGR) REPLACE
*START LISTENER('DEV.LISTENER.TCP') IGNSTATE(YES)
