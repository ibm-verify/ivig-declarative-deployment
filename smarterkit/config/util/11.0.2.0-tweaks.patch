sha1sum -c - << 'EOF' || exit 1
0b374330a31647f89105cc46ff89081fdef977a0  work/parseYaml.sh
42e413107b50953b6c764c944a0a6162dd77865f  work/processOptions.sh
f8a36b4ba24d72d67d48aa19072a8b7d68a6fe0f  work/initIMContainer.sh
bd7e770827aac4c7ce5b81606b3b15aedbeab63d  work/DBPurge.sh
d6e12ac7f8666069f27f1dd36c92dbda87d7297f  opt/ibm/wlp/usr/servers/defaultServer/jvm.options
3fa1a8f7c189113b00772c6d8958a439947bc7d1  work/migrateKeystore.sh
fd412bcab8b3d7bdd34e35056e5d95bdac6d6501  work/renewCerts.sh
EOF

sed -i -e '95r /dev/stdin' work/parseYaml.sh << 'EOF'
	rm /work/cacert.*_*
EOF

sed -i -e '90r /dev/stdin' -e '90,92d' work/parseYaml.sh << 'EOF'
	for CAFILE in /work/cacert.*; do
		[[ -e "$CAFILE" ]] || continue
		csplit -z -s -f "${CAFILE}_" "$CAFILE" '/END CERTIFICATE/+1' '{*}'
	done
	for CA in /work/cacert.*_*; do
		ALIAS="$CA"
EOF

sed -i -e '52r /dev/stdin' work/parseYaml.sh << 'EOF'
handle_secureSessionCookies() {
	if [[ "$1" = "true" ]]; then
		sed -i '/<\/server>/i\
		<httpSession cookieSecure="true" cookieHttpOnly="true" />' "${CONFDIR}/endpoint.xml"
	fi
} #handle_secureSessionCookies

handle_globalHSTS() {
	if [[ "$1" = "true" ]]; then
		sed -i '/<\/server>/i\
		<webContainer addstricttransportsecurityheader="max-age=31536000;includeSubDomains" />' "${CONFDIR}/endpoint.xml"
	fi
} #handle_globalHSTS()

handle_hideServerVersion() {
	if [[ "$1" = "true" ]]; then
		sed -i '/<\/server>/i\
		<httpDispatcher enableWelcomePage="false" />\
		<httpOptions removeServerHeader="true" />\
		<webContainer disableXPoweredBy="true" />' "${CONFDIR}/endpoint.xml"
	fi
} #handle_hideServerVersion()

EOF

sed -i -e '50r /dev/stdin' -e '50d' work/processOptions.sh << 'EOF'
		PASSWORD=$(/opt/ibm/wlp/bin/securityUtility encode --encoding=aes "$PASSWORD" | grep -v IBMJCEPlusFIPS)
EOF

sed -i -e '36r /dev/stdin' -e '36d' work/processOptions.sh << 'EOF'
				PASSWORD="${VALUE:-$LIBERTYMETRICS_PASSWORD}"
EOF

sed -i -e '33r /dev/stdin' -e '33d' work/processOptions.sh << 'EOF'
				USERNAME="${VALUE:-$LIBERTYMETRICS_USERNAME}"
EOF

sed -i -e '456r /dev/stdin' -e '456d' work/initIMContainer.sh << 'EOF'
			cp "${CUSTOMDIR}/restExtensionJars/"*.jar "${RESTEXTENSION}/lib"
EOF

sed -i -e '448r /dev/stdin' -e '448d' work/initIMContainer.sh << 'EOF'
			cp "${CUSTOMDIR}/jars/"*.jar "${SVRDIR}/lib"
EOF

sed -i -e '$s/-Xmx[0-9]\+m/-Xmx4096m/' work/DBPurge.sh

sed -i -e '2s/-Xmx4096m/-Xmx16384m/' opt/ibm/wlp/usr/servers/defaultServer/jvm.options

sed -i -e '145r /dev/stdin' -e '145d' work/migrateKeystore.sh << 'EOF'
	rm -rf "${IM_HOME}"/data/keystore/kek*
EOF

sed -i -e '18r /dev/stdin' -e '18d' work/renewCerts.sh << 'EOF'
cp "$CDIR"/isvgimRootCA.* /work
EOF
