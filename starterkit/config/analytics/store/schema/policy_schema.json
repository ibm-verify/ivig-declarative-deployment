{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "http://example.com/example.json",
  "default": {},
  "title": "Root Schema",
  "required": [
    "id",
    "name",
    "description",
    "policyClass",
    "tntId",
    "riskLevel",
    "policyCategory",
    "aggrInterval",
    "subscribedEvents",
    "associatedEntities",
    "rollupEntities",
    "editable",
    "countBasedAttributes",
    "rules",
    "parameters",
    "policyType",
    "lastEnabledTime",
    "decay",
    "retentionPeriod",
    "status",
    "timeoutDuration",
    "type",
    "isDeleted",
    "decayParameters"
  ],
  "properties": {
    "id": {
      "type": "string",
      "default": "",
      "title": "The id Schema"
    },
    "name": {
      "type": "string",
      "default": "",
      "title": "The name Schema"
    },
    "description": {
      "type": "string",
      "default": "",
      "title": "The description Schema"
    },
    "policyClass": {
      "type": "string",
      "enum": [
        "user",
        "User",
        "account",
        "Account",
        "application",
        "Application",
        "entitlement",
        "Entitlement",
        "assignment",
        "Assignment",
        "risk",
        "Risk"
      ]
    ,
      "title": "The policyClass Schema"
    },
    "tntId": {
      "type": "string",
      "default": "",
      "title": "The tntId Schema"
    },
    "riskLevel": {
      "type": "string",
      "enum": [
        "custom",
        "high",
        "medium",
        "low"
      ],
      "title": "The riskLevel Schema"
    },
    "policyCategory": {
      "type": "string",
      "default": "",
      "title": "The policyCategory Schema"
    },
    "aggrInterval": {
      "type": "string",
      "default": "",
      "title": "The aggrInterval Schema"
    },
    "subscribedEvents": {
      "type": "array",
      "default": [],
      "title": "The subscribedEvents Schema",
      "items": {
        "type": "string",
        "title": "A Schema"
      }
    },
    "type": {
      "type": "string",
      "enum": [
        "POLICY",
        "Policy"
      ],
      "title": "The type Schema"
    },
    "associatedEntities": {
      "type": "array",
      "default": [],
      "title": "The associatedEntities Schema",
      "items": {
        "type": "string",
        "title": "A Schema"
      }
    },
    "rollupEntities": {
      "type": "array",
      "default": [],
      "title": "The rollupEntities Schema",
      "items": {
        "type": "string",
        "default": "",
        "title": "A Schema"
      }
    },
    "editable": {
      "type": "boolean",
      "default": false,
      "title": "The editable Schema"
    },
    "tags": {
      "type": ["array", "null"],
      "items": {
        "type": "string"
      },
      "title": "The tags Schema",
      "default": []
    },
    "rules": {
      "type": "array",
      "title": "Rules Array",
      "items": {
        "type": "object",
        "required": [
          "condition",
          "name",
          "description",
          "id",
          "severityBasedScore",
          "severityType",
          "enabled"
        ],
        "properties": {
          "condition": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "severityBasedScore": {
            "type": "number"
          },
          "severityType": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high"
            ]
          },
          "enabled": {
            "type": "boolean"
          }
        }
      }
    },
    "parameters": {
      "type": [
        "array",
        "null"
      ],
      "default": [],
      "title": "The parameters Schema",
      "items": {
        "type": "object",
        "properties": {
          "defaultValue": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "Integer",
              "String",
              "Boolean",
              "Double"
            ]
          },
          "value": {
            "type": [
              "integer",
              "string",
              "boolean",
              "number"
            ]
          }
        },
        "required": [
          "name",
          "id",
          "type",
          "value",
          "defaultValue"
        ]
      }
    },
    "additionalRequiredAttributes": {
      "type": ["object", "null"],
      "default": {},
      "title": "The additionalRequiredAttributes Schema",
      "required": [],
      "properties": {}
    },
    "metadata": {
      "type": "object",
      "default": {},
      "title": "The metadata Schema",
      "required": [
        "author",
        "createdDate",
        "lastUpdatedDate",
        "version"
      ],
      "properties": {
        "author": {
          "type": "string",
          "default": "",
          "title": "The author Schema"
        },
        "createdDate": {
          "type": "string",
          "default": "",
          "title": "The createdDate Schema"
        },
        "lastUpdatedDate": {
          "type": "string",
          "default": "",
          "title": "The lastUpdatedDate Schema"
        },
        "version": {
          "type": "string",
          "default": "",
          "title": "The version Schema"
        }
      }
    },
    "policyType": {
      "type": "string",
      "enum": [
        "CountBased",
        "AttributeBased"
      ],
      "default": "AttributeBased",
      "title": "The policyType Schema"
    },
    "countBasedAttributes": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "properties": {
          "count": {
            "type": "string",
            "default": null
          }
        },
        "required": [
          "count"
        ]
      },
      "title": "The countBasedAttributes Schema"
    },
    "lastEnabledTime": {
      "type": "integer",
      "default": 0,
      "title": "The lastEnabledTime Schema"
    },
    "decay": {
      "type": "boolean",
      "default": false,
      "title": "The decay Schema"
    },
    "retentionPeriod": {
      "type": "string",
      "default": "",
      "title": "The retentionPeriod Schema"
    },
    "status": {
      "type": "string",
      "enum": [
        "Active",
        "Inactive"
      ],
      "title": "The status Schema"
    },
    "timeoutDuration": {
      "type": "string",
      "default": "",
      "title": "The timeoutDuration Schema"
    },
    "isDeleted": {
      "type": "boolean",
      "default": false,
      "title": "The isDeleted Schema"
    },
    "decayParameters": {
      "type": "object",
      "default": {},
      "title": "The decayParameters Schema",
      "required": [
        "decayFactor",
        "freq",
        "fun",
        "startAfter"
      ],
      "properties": {
        "decayFactor": {
          "type": "number",
          "default": 0,
          "title": "The decayFactor Schema"
        },
        "freq": {
          "type": "string",
          "default": "",
          "title": "The freq Schema"
        },
        "fun": {
          "type": "string",
          "default": "",
          "title": "The fun Schema"
        },
        "startAfter": {
          "type": "integer",
          "default": 0,
          "title": "The startAfter Schema"
        }
      }
    }
  },
  "additionalProperties": false,
  "if": {
    "properties": {
      "policyType": {
        "const": "AttributeBased"
      }
    }
  },
  "then": {
    "properties": {
      "countBasedAttributes": {
        "type": [
          "null",
          "array"
        ],
        "default": [],
        "items": {}
      }
    }
  },
  "else": {
    "properties": {
      "countBasedAttributes": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "properties": {
            "count": {
              "type": "string"
            }
          },
          "required": [
            "count"
          ]
        }
      }
    }
  }
}